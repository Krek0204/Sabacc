# Copy to .env and adjust for your machine or server.
# Do not commit .env.

# Разрешённый origin браузера для REST / WebSocket; без слэша в конце.
APP_ORIGIN=http://localhost

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sabacc

# Frontend API prefix baked into the Vite production build
VITE_API_URL=/api

# Spring cron expression: anonymous users cleanup
CRON_USER_CLEANUP=0 */30 * * * *

# docker-compose.yaml currently starts backend with this profile
SPRING_PROFILES_ACTIVE=prod

# Серверный docker-compose.deploy.yaml: TLS на внешнем proxy того же хоста.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
# Для повторяемого релиза задайте SHA коммита, оставьте предыдущие образы для отката.
RELEASE_TAG=local
