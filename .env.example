# Скопируйте в .env. Не коммитьте реальные пароли.
# Для новой серверной БД замените пароль ДО первого запуска PostgreSQL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sabacc

# Единственный публикуемый порт. Открывать 5432 и 8080 не нужно.
HTTP_PORT=80
# API и WebSocket работают через адрес сайта; публичный IP в сборке не нужен.
VITE_API_URL=/api
CRON_USER_CLEANUP=0 */30 * * * *
