# Copy to .env and adjust for your machine or server.
# Do not commit .env.

# Passed into the backend container. Spring does not read PUBLIC_IP;
# origins live in backend/src/main/resources/application-prod.yml.
# For local Docker use localhost. For a public server put the IP or domain.
PUBLIC_IP=localhost

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sabacc

# Frontend API prefix baked into the Vite production build
VITE_API_URL=/api

# Spring cron expression: anonymous users cleanup
CRON_USER_CLEANUP=0 */30 * * * *

# docker-compose.yaml currently starts backend with this profile
SPRING_PROFILES_ACTIVE=prod
